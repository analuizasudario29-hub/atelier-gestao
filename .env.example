# --- Supabase (Etapa 2: conectado) ---
# Estes valores são PÚBLICOS por natureza (protegidos por RLS no banco).
# Hoje eles também vivem em assets/js/config.js, pois o projeto ainda não
# usa um build tool. Quando o projeto migrar para Vite/Next/etc, use estas
# variáveis no lugar do config.js.
VITE_SUPABASE_URL=https://aevonlnpvppmvtspmizk.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_dr5PtM8YF8e51G9utcryaQ_ev85W1Ya

# --- Supabase service_role key (NUNCA usar no frontend) ---
# Esta chave é SECRETA, tem acesso total ao banco e ignora todas as
# políticas de RLS. Só deve existir em ambientes de servidor (ex: uma
# Edge Function), nunca no navegador, nunca commitada no Git.
# SUPABASE_SERVICE_ROLE_KEY=

# --- Google OAuth (futura Etapa: login social) ---
VITE_GOOGLE_CLIENT_ID=

# --- Gateway de pagamento (futura Etapa: assinatura mensal) ---
VITE_PAYMENT_PUBLIC_KEY=
